# Copy this file to .env.local and fill in real values.
# See PROJECT_DOCUMENTATION/ENVIRONMENT_VARIABLES.md for full explanations.

# Convex Deployment (Development targets dev:optimistic-bulldog-318)
CONVEX_DEPLOYMENT=dev:optimistic-bulldog-318
NEXT_PUBLIC_CONVEX_URL=https://optimistic-bulldog-318.eu-west-1.convex.cloud
NEXT_PUBLIC_CONVEX_SITE_URL=https://optimistic-bulldog-318.eu-west-1.convex.site

# Optional: Contact form email notifications (Nodemailer + SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
CONTACT_FORM_RECIPIENT=

# Site metadata
NEXT_PUBLIC_SITE_URL=http://localhost:3000
